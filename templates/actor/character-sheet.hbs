<div class="interface-sheet__content interface-character {{#if readOnly}}interface-character--read-only{{/if}}">
  <header class="interface-character__identity">
    {{#if editable}}
      <label class="interface-character__name">
        <span>{{localize "INTERFACE.Common.Name"}}</span>
        <input
          id="{{rootId}}-name"
          type="text"
          name="name"
          value="{{actor.name}}"
          autocomplete="off"
        >
      </label>

      <label>
        <span>{{localize "INTERFACE.Identity.Age"}}</span>
        <input type="text" name="system.identity.age" value="{{system.identity.age}}">
      </label>

      <label>
        <span>{{localize "INTERFACE.Identity.Profession"}}</span>
        <input type="text" name="system.identity.profession" value="{{system.identity.profession}}">
      </label>
    {{else}}
      <div class="interface-readonly-field interface-character__name">
        <span>{{localize "INTERFACE.Common.Name"}}</span>
        <strong>{{actor.name}}</strong>
      </div>
      <div class="interface-readonly-field">
        <span>{{localize "INTERFACE.Identity.Age"}}</span>
        <strong>{{#if system.identity.age}}{{system.identity.age}}{{else}}—{{/if}}</strong>
      </div>
      <div class="interface-readonly-field">
        <span>{{localize "INTERFACE.Identity.Profession"}}</span>
        <strong>{{#if system.identity.profession}}{{system.identity.profession}}{{else}}—{{/if}}</strong>
      </div>
    {{/if}}
  </header>

  <div class="interface-sheet__body">

    <section class="interface-skills" aria-labelledby="{{rootId}}-skills">
      <h2 id="{{rootId}}-skills">{{localize "INTERFACE.Section.Skills"}}</h2>
      <div class="interface-skills__grid">
        {{#each skills}}
          <div class="interface-skill interface-tone--{{tone}}">
            {{#if ../editable}}
              <input
                type="number"
                name="system.skills.{{key}}"
                value="{{value}}"
                min="0"
                max="100"
                step="1"
              >
              <button
                type="button"
                class="interface-roll-link interface-roll-link--skill"
                data-action="rollSkill"
                data-skill-key="{{key}}"
                title="{{localize "INTERFACE.D100.RollSkillTitle"}}"
              >{{localize label}}</button>
            {{else}}
              <strong class="interface-skill__value">{{value}}</strong>
              <span class="interface-skill__label">{{localize label}}</span>
            {{/if}}
          </div>
        {{/each}}
      </div>
    </section>

    <section class="interface-state-band" aria-label="{{localize "INTERFACE.Section.Resources"}}">
      <div class="interface-state-band__resource">
        <span class="interface-state-band__label">{{localize "INTERFACE.Resource.Wounds"}}</span>
        {{#if editable}}
          <div class="interface-resource__controls interface-resource__controls--dark">
            <button
              type="button"
              data-action="adjustResource"
              data-resource="wounds"
              data-delta="-1"
              aria-label="{{localize "INTERFACE.Common.Decrease"}}"
            >−</button>
            <input
              type="number"
              name="system.resources.wounds.value"
              value="{{system.resources.wounds.value}}"
              min="0"
              max="15"
              step="1"
            >
            <button
              type="button"
              data-action="adjustResource"
              data-resource="wounds"
              data-delta="1"
              aria-label="{{localize "INTERFACE.Common.Increase"}}"
            >+</button>
          </div>
        {{else}}
          <strong class="interface-resource__readonly">{{system.resources.wounds.value}}</strong>
        {{/if}}
        <div
          class="interface-state-label"
          data-state-level="{{woundState.level}}"
          style="--interface-state-color: {{woundState.color}};"
          aria-label="{{localize "INTERFACE.State.Level"}} {{woundState.level}} : {{localize woundState.label}}"
        >
          {{localize woundState.label}}
        </div>
      </div>

      <div class="interface-state-band__initiative">
        <span>{{localize "INTERFACE.Derived.Initiative"}}</span>
        <strong>+{{derived.initiativeBonus}}</strong>
        <small>{{localize "INTERFACE.Derived.InitiativeBonus"}}</small>
      </div>

      <div class="interface-state-band__resource">
        <span class="interface-state-band__label">{{localize "INTERFACE.Resource.Stress"}}</span>
        {{#if editable}}
          <div class="interface-resource__controls interface-resource__controls--dark">
            <button
              type="button"
              data-action="adjustResource"
              data-resource="stress"
              data-delta="-1"
              aria-label="{{localize "INTERFACE.Common.Decrease"}}"
            >−</button>
            <input
              type="number"
              name="system.resources.stress.value"
              value="{{system.resources.stress.value}}"
              min="0"
              max="15"
              step="1"
            >
            <button
              type="button"
              data-action="adjustResource"
              data-resource="stress"
              data-delta="1"
              aria-label="{{localize "INTERFACE.Common.Increase"}}"
            >+</button>
          </div>
        {{else}}
          <strong class="interface-resource__readonly">{{system.resources.stress.value}}</strong>
        {{/if}}
        <div
          class="interface-state-label"
          data-state-level="{{stressState.level}}"
          style="--interface-state-color: {{stressState.color}};"
          aria-label="{{localize "INTERFACE.State.Level"}} {{stressState.level}} : {{localize stressState.label}}"
        >
          {{localize stressState.label}}
        </div>
      </div>

      <div class="interface-state-band__dev">
        <span>{{localize "INTERFACE.Development.Temporary"}}</span>
        <span>{{localize "INTERFACE.State.TotalPenalty"}} : −{{derived.statePenalty}}</span>
        <span>{{localize "INTERFACE.Resource.Destiny"}} : {{system.resources.destiny.value}}</span>
      </div>
    </section>

    <details class="interface-fold interface-fold--development" data-section="development" {{#if sections.development}}open{{/if}}>
      <summary>
        <span>{{localize "INTERFACE.Development.Title"}}</span>
        <small>{{localize "INTERFACE.Development.TemporaryHint"}}</small>
      </summary>
      <div class="interface-fold__content">
        <div class="interface-dev-grid">
          {{#if editable}}
            <label class="interface-dev-field">
              <span>{{localize "INTERFACE.Resource.Destiny"}}</span>
              <input
                type="number"
                name="system.resources.destiny.value"
                value="{{system.resources.destiny.value}}"
                min="0"
                step="1"
              >
            </label>
          {{else}}
            <div class="interface-dev-field interface-readonly-field">
              <span>{{localize "INTERFACE.Resource.Destiny"}}</span>
              <strong>{{system.resources.destiny.value}}</strong>
            </div>
          {{/if}}
          <div>
            <strong>{{localize "INTERFACE.State.Detail"}}</strong>
            <p>
              ({{derived.levels.wounds}} + {{derived.levels.stress}})
              × {{statePenaltyCoefficient}}
              = {{derived.statePenalty}}
            </p>
          </div>
          <div>
            <strong>{{localize "INTERFACE.Creation.TalentTotal"}}</strong>
            <p>{{creation.talentTotal}} / 100</p>
          </div>
        </div>

        {{#if creation.showWarnings}}
          <div class="interface-notice interface-notice--warning">
            <strong>{{localize "INTERFACE.Creation.WarningTitle"}}</strong>
            <ul>
              {{#each creation.warnings}}
                <li>{{message}}</li>
              {{/each}}
            </ul>
            <p>{{localize "INTERFACE.Creation.NonBlocking"}}</p>
            {{#if editable}}
              <button type="button" data-action="acknowledgeCreationWarnings">
                <i class="fa-solid fa-check" aria-hidden="true"></i>
                {{localize "INTERFACE.Creation.Acknowledge"}}
              </button>
            {{/if}}
          </div>
        {{else}}
          {{#if creation.acknowledged}}
            <p class="interface-notice interface-notice--acknowledged">
              {{localize "INTERFACE.Creation.Acknowledged"}}
            </p>
          {{else}}
            <p class="interface-notice interface-notice--success">
              {{localize "INTERFACE.Creation.RecommendedDistribution"}}
            </p>
          {{/if}}
        {{/if}}
      </div>
    </details>

    <details class="interface-fold" data-section="talents" {{#if sections.talents}}open{{/if}}>
      <summary>
        <span>{{localize "INTERFACE.Section.Talents"}}</span>
        <small>{{creation.talentTotal}} / 100</small>
      </summary>
      <div class="interface-fold__content">
        <div class="interface-talent-groups">
          {{#each talentGroups}}
            <fieldset class="interface-talent-group interface-tone--{{tone}}">
              <legend>{{localize label}}</legend>
              {{#each talents}}
                <div class="interface-talent">
                  {{#if ../../editable}}
                    <button
                      type="button"
                      class="interface-roll-link interface-roll-link--talent"
                      data-action="rollTalent"
                      data-skill-key="{{../skill}}"
                      data-talent-key="{{key}}"
                      title="{{localize "INTERFACE.D100.RollTalentTitle"}}"
                    >{{localize label}}</button>
                    <input
                      type="number"
                      name="system.talents.{{key}}"
                      value="{{value}}"
                      min="0"
                      max="30"
                      step="1"
                    >
                  {{else}}
                    <span class="interface-talent__label">{{localize label}}</span>
                    <strong class="interface-talent__value">{{value}}</strong>
                  {{/if}}
                </div>
              {{/each}}
            </fieldset>
          {{/each}}
        </div>
      </div>
    </details>

    <details class="interface-fold" data-section="combat" {{#if sections.combat}}open{{/if}}>
      <summary>
        <span>{{localize "INTERFACE.Section.Combat"}}</span>
        <small>{{localize "INTERFACE.Section.Derived"}} · {{localize "INTERFACE.Section.Weapons"}}</small>
      </summary>
      <div class="interface-fold__content">
        <div class="interface-derived-grid">
          {{#each derivedScores}}
            {{#if ../editable}}
              <button
                type="button"
                class="interface-derived-card interface-tone--{{tone}}"
                data-action="rollDerived"
                data-derived-key="{{key}}"
                title="{{localize "INTERFACE.D100.RollDerivedTitle"}}"
              >
                <span>{{localize label}}</span>
                <strong>{{value}}</strong>
              </button>
            {{else}}
              <div class="interface-derived-card interface-tone--{{tone}}">
                <span>{{localize label}}</span>
                <strong>{{value}}</strong>
              </div>
            {{/if}}
          {{/each}}

          {{#if customDerived.enabled}}
            {{#if editable}}
              <button
                type="button"
                class="interface-derived-card interface-tone--neutral"
                data-action="rollDerived"
                data-derived-key="custom"
                title="{{localize "INTERFACE.D100.RollDerivedTitle"}}"
                {{#unless customDerived.available}}disabled{{/unless}}
              >
                <span>{{customDerived.name}}</span>
                {{#if customDerived.available}}
                  <strong>{{customDerived.value}}</strong>
                {{else}}
                  <strong>—</strong>
                {{/if}}
              </button>
            {{else}}
              <div class="interface-derived-card interface-tone--neutral">
                <span>{{customDerived.name}}</span>
                {{#if customDerived.available}}
                  <strong>{{customDerived.value}}</strong>
                {{else}}
                  <strong>—</strong>
                {{/if}}
              </div>
            {{/if}}
          {{/if}}
        </div>

        <div class="interface-subsection-heading">
          <h3>{{localize "INTERFACE.Section.Weapons"}}</h3>
          {{#if editable}}
            <button
              type="button"
              data-action="createEquipment"
              data-category="{{categories.WEAPON}}"
            >
              <i class="fa-solid fa-plus" aria-hidden="true"></i>
              {{localize "INTERFACE.Inventory.AddWeapon"}}
            </button>
          {{/if}}
        </div>

        {{#if hasWeapons}}
          <ol class="interface-item-list interface-item-list--weapons">
            {{#each weapons}}
              <li class="interface-item-row" data-item-id="{{id}}">
                <img src="{{img}}" alt="">
                {{#if ../editable}}
                  <button
                    type="button"
                    class="interface-item-row__name"
                    data-action="editEmbeddedItem"
                  >{{name}}</button>
                {{else}}
                  <span class="interface-item-row__name interface-item-row__name--readonly">{{name}}</span>
                {{/if}}
                <span>×{{quantity}}</span>
                <span class="interface-item-row__formula">{{damageFormula}}</span>
              </li>
            {{/each}}
          </ol>
        {{else}}
          <p class="interface-empty">{{localize "INTERFACE.Inventory.NoWeapons"}}</p>
        {{/if}}
      </div>
    </details>

    <details class="interface-fold" data-section="specializations" {{#if sections.specializations}}open{{/if}}>
      <summary>
        <span>{{localize "INTERFACE.Section.Specializations"}}</span>
        <small>{{localize "INTERFACE.Specializations.Hint"}}</small>
      </summary>
      <div class="interface-fold__content">
        {{#if editable}}
          <textarea name="system.identity.specializations" rows="6">{{system.identity.specializations}}</textarea>
        {{else}}
          <div class="interface-readonly-text">{{#if system.identity.specializations}}{{system.identity.specializations}}{{else}}—{{/if}}</div>
        {{/if}}
      </div>
    </details>

    <details class="interface-fold" data-section="inventory" {{#if sections.inventory}}open{{/if}}>
      <summary>
        <span>{{localize "INTERFACE.Section.Inventory"}}</span>
        <small>{{inventory.length}}</small>
      </summary>
      <div class="interface-fold__content">
        {{#if editable}}
          <div class="interface-panel__actions">
            <button
              type="button"
              data-action="createEquipment"
              data-category="{{categories.ORDINARY}}"
            >
              <i class="fa-solid fa-plus" aria-hidden="true"></i>
              {{localize "INTERFACE.Inventory.AddOrdinary"}}
            </button>
            <button
              type="button"
              data-action="createEquipment"
              data-category="{{categories.WEAPON}}"
            >
              <i class="fa-solid fa-plus" aria-hidden="true"></i>
              {{localize "INTERFACE.Inventory.AddWeapon"}}
            </button>
          </div>
        {{/if}}

        {{#if hasInventory}}
          <ol class="interface-item-list">
            {{#each inventory}}
              <li class="interface-item-row" data-item-id="{{id}}">
                <img src="{{img}}" alt="">
                {{#if ../editable}}
                  <button
                    type="button"
                    class="interface-item-row__name"
                    data-action="editEmbeddedItem"
                  >{{name}}</button>
                {{else}}
                  <span class="interface-item-row__name interface-item-row__name--readonly">{{name}}</span>
                {{/if}}
                <span>{{localize categoryLabel}}</span>
                <span>×{{quantity}}</span>
                {{#if isWeapon}}
                  <span class="interface-item-row__formula">{{damageFormula}}</span>
                {{/if}}
              </li>
            {{/each}}
          </ol>
        {{else}}
          <p class="interface-empty">{{localize "INTERFACE.Inventory.Empty"}}</p>
        {{/if}}
        {{#if editable}}
          <p class="hint">{{localize "INTERFACE.Inventory.DropHint"}}</p>
        {{/if}}
      </div>
    </details>

    <details class="interface-fold" data-section="notes" {{#if sections.notes}}open{{/if}}>
      <summary>
        <span>{{localize "INTERFACE.Section.Notes"}}</span>
        <small>{{localize "INTERFACE.Notes.Hint"}}</small>
      </summary>
      <div class="interface-fold__content">
        {{#if editable}}
          <textarea name="system.identity.notes" rows="10">{{system.identity.notes}}</textarea>
        {{else}}
          <div class="interface-readonly-text">{{#if system.identity.notes}}{{system.identity.notes}}{{else}}—{{/if}}</div>
        {{/if}}
      </div>
    </details>

    <section class="interface-progression" aria-labelledby="{{rootId}}-progression">
      <div class="interface-progression__band">
        <strong id="{{rootId}}-progression">{{localize "INTERFACE.Section.Progression"}}</strong>
        <div class="interface-progression__gauge">
          {{#each progressionGauge}}
            {{#if ../editable}}
              <label title="{{value}}">
                <input
                  type="radio"
                  name="system.progression.gauge"
                  value="{{value}}"
                  {{#if checked}}checked{{/if}}
                >
                <span>{{value}}</span>
              </label>
            {{else}}
              <span class="interface-progression__readonly-dot {{#if checked}}is-current{{/if}}">{{value}}</span>
            {{/if}}
          {{/each}}
        </div>
        <span>{{localize "INTERFACE.Progression.GaugeHint"}}</span>
      </div>

      <div class="interface-progression__choices">
        {{#each progressionGroups}}
          <fieldset>
            <legend>{{localize label}}</legend>
            <small>{{localize detail}}</small>
            <div>
              {{#each gains}}
                {{#if ../../editable}}
                  <label>
                    <input
                      type="checkbox"
                      name="system.progression.{{../key}}.{{key}}"
                      {{#if checked}}checked{{/if}}
                    >
                    <span>{{index}}</span>
                  </label>
                {{else}}
                  <span class="interface-progression__readonly-dot {{#if checked}}is-current{{/if}}">{{index}}</span>
                {{/if}}
              {{/each}}
            </div>
          </fieldset>
        {{/each}}
      </div>
      <p class="hint">{{localize "INTERFACE.Progression.ManualHint"}}</p>
    </section>
  </div>

  {{#if editable}}
  <footer class="interface-sheet__footer">
    <span class="interface-autosave">
      <i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i>
      {{localize "INTERFACE.Common.AutoSaveActive"}}
    </span>
    <button type="submit">
      <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>
      {{localize "INTERFACE.Common.Save"}}
    </button>
  </footer>  {{/if}}

</div>
