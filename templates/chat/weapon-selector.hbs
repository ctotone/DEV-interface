<article
  class="interface-chat-card interface-chat-card--damage"
  data-interface-card
  data-interface-theme="{{theme}}"
>
  <header class="interface-chat-card__header">
    <img class="interface-chat-card__portrait" src="{{actorImg}}" alt="{{actorName}}">
    <div class="interface-chat-card__identity">
      <strong class="interface-chat-card__actor{{#if compactActorName}} interface-chat-card__actor--compact{{/if}}">
        {{actorName}}
      </strong>
    </div>
  </header>

  <div class="interface-chat-card__selector-label">{{chooseWeaponLabel}}</div>

  {{#if hasWeapons}}
    <div class="interface-chat-card__weapons">
      {{#each weapons}}
        <button
          type="button"
          class="interface-chat-card__weapon-button{{#unless valid}} interface-chat-card__weapon-button--invalid{{/unless}}"
          data-interface-action="roll-damage"
          data-weapon-index="{{index}}"
          data-interface-weapon-valid="{{valid}}"
          {{#unless valid}}disabled{{/unless}}
          title="{{buttonTitle}}"
        >
          <img class="interface-chat-card__weapon-img" src="{{img}}" alt="">
          <span class="interface-chat-card__weapon-name">{{name}}</span>
        </button>
      {{/each}}
    </div>
  {{else}}
    <p class="interface-chat-card__notice">{{noWeaponsLabel}}</p>
  {{/if}}
</article>
